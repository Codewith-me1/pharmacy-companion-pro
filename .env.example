# Copy this file to .env and fill in your values.
# .env and every .env.* variant are gitignored — never commit real credentials.

# Required for AI-powered purchase invoice OCR (Purchase Entry module).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required for AI-powered purchase invoice OCR (Purchase Entry module). The invoice photo is
# first sent to Azure Document Intelligence's prebuilt-layout model to get accurate OCR text and
# table row/column structure; that structured text (not the raw photo) is then handed to ChatGPT
# for semantic field mapping. Create a "Document Intelligence" resource in the Azure portal to get
# these two values (Keys and Endpoint blade).
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Optional. Model used for the ChatGPT semantic-mapping step above. Defaults to gpt-4o if unset.
OPENAI_EXTRACTION_MODEL=

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# ADMIN connection, used by migrations (drizzle-kit) and the one-off scripts in scripts/.
# Use Supabase's SESSION-mode pooler — host aws-<n>-<region>.pooler.supabase.com, port 5432,
# username postgres.<project-ref>. Find it in the dashboard under Connect → Session pooler.
#
# Do NOT use the "direct connection" host (db.<ref>.supabase.co): it resolves to an IPv6 address
# only, so it is unreachable from IPv4-only networks and from most serverless platforms.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# RUNTIME connection for the app itself: a restricted role with no BYPASSRLS, over the
# TRANSACTION-mode pooler (port 6543), which suits short web requests.
#
# This is a hard security requirement, not a nicety. Supabase's `postgres` role has
# rolbypassrls = true, so an app connecting with DATABASE_URL would silently ignore every
# per-pharmacy Row-Level Security policy and serve one pharmacy's data to another. The app
# refuses to start in production without this set.
#
# Create the role (and have this line written for you) with:
#   npm run db:provision-app-role -- --write-env
# Verify the whole posture afterwards with:
#   npm run db:verify-security
APP_DATABASE_URL=postgresql://medios_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional. Only for a Postgres whose CA is neither public nor the pinned Supabase root.
# Disables server certificate verification, so it is REFUSED in production.
# DATABASE_SSL_INSECURE=true

# Optional. Set when copying data from a previous database (scripts/migrate-data.ts).
# LEGACY_DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth / security
# ---------------------------------------------------------------------------
# Secret used to sign/encrypt the login session cookie. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it logs every user out; never reuse the value across environments.
SESSION_SECRET=

# Optional. Set to any value when the app runs behind a reverse proxy/CDN that overwrites
# X-Forwarded-For, so per-IP login rate limiting reads the real client address. Automatically
# on when VERCEL is set. Leave unset otherwise — trusting the header without a proxy in front
# lets a caller spoof it and bypass the IP limit.
# TRUST_PROXY=1

# Optional. scrypt memory cost for password hashing (default 65536 = 64MB per hash).
# Lower it only on a memory-constrained host; existing hashes keep working either way.
# SCRYPT_COST_N=65536
